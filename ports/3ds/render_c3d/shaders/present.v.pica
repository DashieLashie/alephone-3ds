; Aleph One 3DS, citro3d back end (docs/3ds/CITRO3D_DESIGN.md, 5.1): the present quad.
; A position in screen pixels (x right, y down) and a texture coordinate, nothing else.
; Assembled by picasso through ports/3ds/CMakeLists.txt (ctr_add_shader_library).

; Uniforms
.fvec projection[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.0)
.alias  ones myconst.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0

; Inputs
.alias inpos v0
.alias intex v1

.proc main
	; w = 1
	mov r0.xyz, inpos
	mov r0.w,   ones

	; outpos = projection * inpos
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intex

	end
.end
